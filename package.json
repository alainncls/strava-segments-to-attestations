{
  "name": "strava-segments-to-attestations",
  "version": "1.0.0",
  "private": true,
  "description": "Create Verax attestations for Strava segments you've completed",
  "keywords": [
    "strava",
    "verax",
    "attestation",
    "linea",
    "blockchain"
  ],
  "license": "MIT",
  "author": "alain.linea.eth",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "pnpm -r --if-present run clean && node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "dev": "corepack pnpm --filter @strava-attestations/shared build && corepack pnpm -r --parallel run dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @strava-attestations/frontend test:e2e",
    "test:coverage": "pnpm -r test:coverage",
    "verify:oauth-preview": "pnpm --filter @strava-attestations/functions exec tsx verify-netlify-preview.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-solidity": "2.4.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
